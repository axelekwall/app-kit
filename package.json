{
  "name": "@axelekwall/app-kit",
  "version": "0.1.1",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.4",
  "bin": {
    "app-kit": "./src/cli/main.ts"
  },
  "exports": {
    "./biome.json": "./config/biome.base.json",
    "./tsconfig.json": "./config/tsconfig.base.json",
    "./sync": "./src/cli/sync.ts",
    "./package.json": "./package.json"
  },
  "scripts": {
    "setup": "bun install && git config core.hooksPath .githooks",
    "check": "biome check .",
    "check:fix": "biome check --write .",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "verify": "bun run check && bun run typecheck && bun run test",
    "verify:full": "bun run verify",
    "kit:sync": "bun src/cli/main.ts sync"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.12",
    "@types/bun": "1.4.3",
    "typescript": "7.0.2"
  }
}
