{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(bun *)",
      "Bash(bunx biome *)",
      "Bash(mise exec -- bun *)",
      "Bash(git status *)",
      "Bash(git log *)",
      "Bash(git diff *)",
      "Bash(git show *)",
      "Bash(git branch --show-current)",
      "Bash(git branch --list *)",
      "Bash(git rev-parse *)",
      "Bash(git merge-base *)",
      "Bash(git ls-files *)",
      "Bash(git fetch *)",
      "Bash(git switch *)",
      "Bash(git checkout -b *)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git stash push *)",
      "Bash(git stash list *)",
      "Bash(git stash show *)",
      "Bash(git stash apply *)",
      "Bash(git rebase *)",
      "Bash(git cherry-pick *)",
      "Bash(git worktree list *)",
      "Bash(git push *)",
      "Bash(gh pr create *)",
      "Bash(gh pr view *)",
      "Bash(gh pr edit *)",
      "Bash(gh pr comment *)",
      "Bash(gh pr checks *)",
      "Bash(gh pr diff *)",
      "Bash(gh pr list *)",
      "Bash(gh run list *)",
      "Bash(gh run view *)",
      "Bash(gh api --method GET *)",
      "Bash(gh api -X GET *)",
      "Bash(playwright-cli *)"
    ],
    "ask": ["Bash(gh api * -X*)", "Bash(gh api * --method*)", "Bash(gh api *graphql*)"],
    "deny": [
      "Bash(git push --force *)",
      "Bash(git push * --force)",
      "Bash(git push * --force *)",
      "Bash(git push -f *)",
      "Bash(git push * -f)",
      "Bash(git push * -f *)",
      "Bash(git push * +*)",
      "Bash(git push *--delete*)",
      "Bash(git push -d *)",
      "Bash(git push * -d *)",
      "Bash(git push * :**)",
      "Bash(git push *--mirror*)",
      "Bash(git push *--prune*)",
      "Bash(git push *--tags*)",
      "Bash(git push *--follow-tags*)",
      "Bash(git push *--no-verify*)",
      "Bash(git stash drop *)",
      "Bash(git stash clear *)",
      "Bash(git switch *--discard-changes*)",
      "Bash(git switch *--force*)",
      "Bash(git switch -f *)",
      "Bash(git switch * -f)",
      "Bash(git switch * -f *)",
      "Bash(gh pr comment *--delete-last*)",
      "Bash(bun publish *)",
      "Bash(mise exec -- bun publish *)"
    ]
  }
}
